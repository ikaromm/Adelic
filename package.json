{
  "name": "adelic",
  "version": "0.5.2",
  "private": true,
  "description": "Aplicativo local para conversar e coordenar agentes de IA",
  "author": "Adelic",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx server/cli.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/cli.ts",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && node node_modules/electron/install.js && env -u ELECTRON_RUN_AS_NODE electron .desktop/app",
    "package:linux": "npm run desktop:build && node scripts/package-linux.mjs",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && playwright test",
    "release": "node scripts/release.mjs",
    "coverage": "vitest run --coverage",
    "remote-user": "tsx scripts/remote-user.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "express": "^5.1.0",
    "lucide-react": "1.52.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  }
}
